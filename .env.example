# Adresse de contact annoncee aux serveurs crawles (recommande : permet a un
# webmaster de vous joindre plutot que de vous bloquer).
CR_CONTACT_EMAIL=

# Politesse reseau
CR_DOMAIN_DELAY=1.5      # secondes entre deux requetes vers un meme domaine
CR_CONCURRENCY=8         # domaines traites en parallele
CR_MAX_PAGES=12          # pages explorees par site
CR_TIMEOUT=12
CR_RESPECT_ROBOTS=1      # 0 pour ignorer robots.txt (deconseille)

# Sonde SMTP (lente, souvent faussee par les catch-all et le greylisting)
CR_SMTP_PROBE=0
CR_SMTP_FROM=verify@example.org

# Emplacements
# CR_DB_PATH=data/candidature-radar.sqlite3
# CR_EXPORT_DIR=data/exports
