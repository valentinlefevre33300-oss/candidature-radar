# Adresse de contact annoncee aux serveurs crawles (recommande : permet a un
# webmaster de vous joindre plutot que de vous bloquer).
CR_CONTACT_EMAIL=

# Politesse reseau
CR_DOMAIN_DELAY=1.5      # secondes entre deux requetes vers un meme domaine
CR_CONCURRENCY=8         # domaines traites en parallele
CR_MAX_PAGES=12          # pages explorees par site
CR_TIMEOUT=12
CR_RESPECT_ROBOTS=1      # 0 pour ignorer robots.txt (deconseille)

# Sonde SMTP (lente, souvent faussee par les catch-all et le greylisting)
CR_SMTP_PROBE=0
CR_SMTP_FROM=verify@example.org

# Emplacements
# CR_DB_PATH=data/candidature-radar.sqlite3
# CR_EXPORT_DIR=data/exports

# --- Campagnes -------------------------------------------------------------
# Client OAuth Google (Google Cloud -> Identifiants -> ID client OAuth, application Web,
# URI de redirection : http://localhost:8010/api/gmail/callback). Activer l'API Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redaction du paragraphe par entreprise. Absente : repli par regles.
ANTHROPIC_API_KEY=
CR_CLAUDE_MODEL=claude-opus-5

# URL publique de l'app (deploiement), pour le pixel d'ouverture. Vide en local.
CR_PUBLIC_URL=
CR_BASE_URL=http://localhost:8010

# Plafonds d'envoi
CR_MONTHLY_CAP=200
CR_DAILY_CAP=25
CR_SEND_INTERVAL=240     # secondes minimum entre deux envois

# 1 = simulation forcee (aucun mail ne part). L'interrupteur des reglages suffit en usage normal.
CR_DRY_RUN=0
