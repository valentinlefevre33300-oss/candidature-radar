{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": { "format": "%(asctime)s %(levelname)s %(name)s: %(message)s", "datefmt": "%Y-%m-%d %H:%M:%S" }
  },
  "handlers": {
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "data/logs/serveur.log",
      "maxBytes": 5000000,
      "backupCount": 2,
      "encoding": "utf-8",
      "formatter": "plain"
    }
  },
  "root": { "level": "INFO", "handlers": ["file"] },
  "loggers": {
    "uvicorn": { "level": "INFO", "handlers": ["file"], "propagate": false },
    "uvicorn.error": { "level": "INFO", "handlers": ["file"], "propagate": false },
    "uvicorn.access": { "level": "INFO", "handlers": ["file"], "propagate": false }
  }
}
